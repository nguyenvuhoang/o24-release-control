# Control Center login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
COOKIE_SECURE=true
CONTROL_CONFIG_PATH=/config/environments.json
CONTROL_DATA_DIR=/data

# Set true only for local testing without HTTPS.
ALLOW_HTTP_AGENTS=false

# DEV agent
DEV_AGENT_KEY=dev-key-change-me
DEV_AGENT_SECRET=change-me-dev-secret-at-least-32-characters
DEV_CF_ACCESS_CLIENT_ID=
DEV_CF_ACCESS_CLIENT_SECRET=

# UAT agent
UAT_AGENT_KEY=ips-uat
UAT_AGENT_SECRET=9900391d1bce03f32aee5e5b552c93731638a21906b40000a84de4bef71ae390
UAT_CF_ACCESS_CLIENT_ID=
UAT_CF_ACCESS_CLIENT_SECRET=

# PROD agent
PROD_AGENT_KEY=prod-key-change-me
PROD_AGENT_SECRET=change-me-prod-secret-at-least-32-characters
PROD_CF_ACCESS_CLIENT_ID=
PROD_CF_ACCESS_CLIENT_SECRET=

# GitHub Actions build trigger (server-side only — never expose to the browser,
# never prefix with NEXT_PUBLIC_). Used to dispatch apps/w4s's build-o24.yml
# workflow, which builds a service image and pushes it to Docker Hub. Release
# Control never builds Docker images itself; the Deploy Agent never builds
# either — both stay unchanged. This only replaces manually clicking "Run
# workflow" on GitHub.
GITHUB_TOKEN=CHANGE_ME_GITHUB_PAT_WITH_ACTIONS_WRITE_SCOPE
GITHUB_OWNER=nguyenvuhoang
GITHUB_REPO=w4s
GITHUB_WORKFLOW=build-o24.yml
GITHUB_BUILD_BRANCH=developer
GITHUB_API_VERSION=2026-03-10
