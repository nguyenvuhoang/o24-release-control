# Control Center login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
COOKIE_SECURE=true
CONTROL_CONFIG_PATH=/config/environments.json
CONTROL_DATA_DIR=/data

# Set true only for local testing without HTTPS.
ALLOW_HTTP_AGENTS=false

# DEV agent
DEV_AGENT_KEY=dev-key-change-me
DEV_AGENT_SECRET=change-me-dev-secret-at-least-32-characters
DEV_CF_ACCESS_CLIENT_ID=
DEV_CF_ACCESS_CLIENT_SECRET=

# UAT agent
UAT_AGENT_KEY=uat-key-change-me
UAT_AGENT_SECRET=change-me-uat-secret-at-least-32-characters
UAT_CF_ACCESS_CLIENT_ID=
UAT_CF_ACCESS_CLIENT_SECRET=

# PROD agent
PROD_AGENT_KEY=prod-key-change-me
PROD_AGENT_SECRET=change-me-prod-secret-at-least-32-characters
PROD_CF_ACCESS_CLIENT_ID=
PROD_CF_ACCESS_CLIENT_SECRET=
